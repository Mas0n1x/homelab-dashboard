# Homelab Dashboard — Bot-Runtime — Beispiel-Umgebung
# Kopiere nach .env und fülle die Werte aus.

# Port des Bot-Runtime-Services (Standard 3200)
PORT=3200

# Speicherort der SQLite-Datenbank (im Container /app/data/bots.db)
BOT_DB_PATH=/app/data/bots.db

# Gemeinsames Bearer-Token: Das Dashboard-Backend muss GENAU dieses Token
# als BOT_RUNTIME_TOKEN kennen, um die Steuerungs-API aufrufen zu dürfen.
BOT_RUNTIME_TOKEN=

# WICHTIG: Setze KEIN globales DISCORD_BOT_TOKEN hier — beide Bots (Portfolio,
# SaleNet) würden sonst dasselbe Token verwenden. Die einzelnen Bot-Tokens
# werden pro Bot in der DB gespeichert (über die Dashboard-Oberfläche).

# ── Portfolio-Bot (optional per Env statt DB) ──────────────────────────
# GitHub-Anbindung (kann alternativ im Panel gesetzt werden)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Öffentliche URL, unter der GitHub die Webhooks erreicht
# (zeigt aufs Dashboard, das an die Bot-Runtime weiterleitet):
PORTFOLIO_WEBHOOK_URL=https://dash.mas0n1x.online/api/bots/portfolio/webhook/github

# "Meine Server"-Funktion: Anbindung ans Dashboard (Serverstatus).
# Da Bot-Runtime und Dashboard im selben Compose-Netz laufen, direkt intern:
HOMELAB_API_URL=http://backend:3001
HOMELAB_USER=
HOMELAB_PASSWORD=

# /minecraft Slash-Command (optional Vorbelegung)
MC_SERVER_IP=
MC_MAP_URL=

# ── SaleNet-Bot ─────────────────────────────────────────────────────────
# Token wird i.d.R. über die Dashboard-Oberfläche in der DB gesetzt.
# Alternativ hier ein SaleNet-EIGENES Env (NICHT das gemeinsame DISCORD_BOT_TOKEN):
SALENET_DISCORD_BOT_TOKEN=
# Eigene SQLite-Datei des SaleNet-Bots (Standard: /app/data/salenet.db)
SALENET_DB_PATH=/app/data/salenet.db
# Produktquelle für den Content-Poster (öffentliche SaleNet-Produkt-API):
SALENET_PRODUCTS_URL=
# Optional: nur für die Health-Anzeige im Systemstatus-Embed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
