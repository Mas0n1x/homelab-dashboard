events {
    worker_connections 1024;
}

http {
    resolver 127.0.0.11 valid=30s;

    # Echte Besucher-Adresse hinter dem Cloudflare-Tunnel. Nur Anfragen aus dem
    # Docker-Netz (dort kommt cloudflared an) dürfen den Kopf bestimmen — wer aus
    # dem Heimnetz direkt zugreift, behält seine eigene Adresse.
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 127.0.0.1;
    real_ip_header CF-Connecting-IP;

    # Antworten komprimieren (JSON-Listen schrumpfen auf rund ein Zehntel)
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml application/manifest+json;

    # Rate limiting for auth endpoints (brute-force protection)
    limit_req_zone $binary_remote_addr zone=auth:10m rate=5r/s;

    # Default server (homelab dashboard)
    server {
        listen 80 default_server;
        server_name _;

        # Upstreams als Variablen + resolver -> nginx löst die Container-IPs zur
        # LAUFZEIT auf statt sie beim Start zu cachen. Sonst zeigt nginx nach einem
        # "docker compose up --build" (Container bekommt neue IP) auf die alte IP
        # und liefert 502, bis man nginx neu startet. 
        set $frontend_upstream http://frontend:3000;
        set $backend_upstream  http://backend:3001;

        # Security headers
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;

        # Frontend
        location / {
            proxy_pass $frontend_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_cache_bypass $http_upgrade;
        }

        # Auth API (rate limited)
        location /api/auth {
            limit_req zone=auth burst=10 nodelay;
            proxy_pass $backend_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # Mail inbound webhook (large payloads for attachments)
        location /api/mail/inbound {
            client_max_body_size 30m;
            proxy_pass $backend_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 30;
        }

        # Datei-Explorer: Uploads (Cloudflare lässt im Free-Tarif höchstens 100 MB durch)
        location /api/files/upload {
            client_max_body_size 100m;
            proxy_pass $backend_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 300;
        }

        # Backend API
        location /api {
            # Ohne Angabe gilt 1 MB — zu wenig für Mail-Anhänge (Backend-Limit 48 MB).
            client_max_body_size 50m;
            proxy_pass $backend_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 300;
            proxy_connect_timeout 60;
        }

        # Minecraft-Live-Konsole (WebSocket-Proxy zum Backend)
        location /api/minecraft/console {
            proxy_pass $backend_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 86400;
        }

        # WebSocket
        location /ws {
            proxy_pass $backend_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 86400;
        }
    }
}
