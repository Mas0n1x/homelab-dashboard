# JWT Secret - WICHTIG: Ändere diesen Wert vor dem öffentlichen Deployment!
# Generiere z.B. mit: openssl rand -hex 32
JWT_SECRET=dein-geheimer-schluessel-hier

# Cloudflare Tunnel Token
# Erstelle einen Tunnel unter: https://one.dash.cloudflare.com -> Networks -> Tunnels
# Setze als Public Hostname: http://nginx:80
CLOUDFLARE_TUNNEL_TOKEN=dein-tunnel-token-hier

# Cloudflare API Token
# Für Worker-Deployment und Email-Routing Konfiguration
# Erstelle einen Custom Token unter: https://dash.cloudflare.com/profile/api-tokens
# Erforderliche Berechtigungen:
#   - Konto: Workers-Skripts: Bearbeiten
#   - Zone: Email Routing Rules: Bearbeiten
#   - Zone: Zone Settings: Lesen
CLOUDFLARE_API_TOKEN=dein-api-token-hier

# ── Remote-Docker über SSH (z. B. der VPS) ──
# Der SSH-Key wird read-only in den Backend-Container gemountet (kein offener
# Docker-Port nötig). SSH_KEY_HOST_PATH = Ordner auf dem HOST, der den Key enthält;
# SSH_KEY_PATH = Pfad zur Key-Datei IM Container.
# 1. Key des Pi (mit VPS-Zugriff) in einen Ordner legen, z. B. ./ssh/id_ed25519
# 2. Server im Dashboard anlegen mit sshHost/sshUser (ssh_host, ssh_user in der DB)
SSH_KEY_HOST_PATH=./ssh
SSH_KEY_PATH=/app/ssh/id_ed25519
