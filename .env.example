# JWT Secret - WICHTIG: Ändere diesen Wert vor dem öffentlichen Deployment!
# Ohne gesetzten Wert bricht das Backend den Start ab (kein Default-Secret).
# Generiere z.B. mit: openssl rand -hex 32
JWT_SECRET=dein-geheimer-schluessel-hier

# ── Schlüssel für gespeicherte Mail-Zugangsdaten ──
# BEWUSST GETRENNT vom JWT_SECRET: früher wurde der Verschlüsselungsschlüssel aus
# dem JWT_SECRET abgeleitet. Als es am 01.09.2026 rotiert wurde (richtig, es war
# ein bekannter Default), waren in derselben Sekunde alle gespeicherten
# Mail-Zugänge unlesbar. Ein Auth-Geheimnis muss rotierbar sein, ohne Daten zu
# verlieren. Fehlt MAIL_CRYPT_KEY, wird auf JWT_SECRET zurückgefallen und beim
# Start gewarnt.
# Generiere mit: openssl rand -hex 32
MAIL_CRYPT_KEY=

# Alte Mail-Schlüssel (komma-getrennt) — nur während einer Rotation nötig, damit
# bestehende Datensätze weiter lesbar sind. Ablauf:
#   1. alten Wert hier eintragen, neuen in MAIL_CRYPT_KEY
#   2. Backend neu starten
#   3. scripts/mail-crypt-rotate.mjs --apply im Backend-Container laufen lassen
#   4. diese Zeile wieder leeren und Backend neu starten
MAIL_CRYPT_KEY_LEGACY=

# Cloudflare Tunnel Token
# Erstelle einen Tunnel unter: https://one.dash.cloudflare.com -> Networks -> Tunnels
# Setze als Public Hostname: http://nginx:80
CLOUDFLARE_TUNNEL_TOKEN=dein-tunnel-token-hier

# Cloudflare API Token
# Für Worker-Deployment und Email-Routing Konfiguration
# Erstelle einen Custom Token unter: https://dash.cloudflare.com/profile/api-tokens
# Erforderliche Berechtigungen:
#   - Konto: Workers-Skripts: Bearbeiten
#   - Zone: Email Routing Rules: Bearbeiten
#   - Zone: Zone Settings: Lesen
CLOUDFLARE_API_TOKEN=dein-api-token-hier

# ── Remote-Docker über SSH (z. B. der VPS) ──
# Der SSH-Key wird read-only in den Backend-Container gemountet (kein offener
# Docker-Port nötig). SSH_KEY_HOST_PATH = Ordner auf dem HOST, der den Key enthält;
# SSH_KEY_PATH = Pfad zur Key-Datei IM Container.
# 1. Key des Pi (mit VPS-Zugriff) in einen Ordner legen, z. B. ./ssh/id_ed25519
# 2. Server im Dashboard anlegen mit sshHost/sshUser (ssh_host, ssh_user in der DB)
SSH_KEY_HOST_PATH=./ssh
SSH_KEY_PATH=/app/ssh/id_ed25519

# ── Discord-Bots (Steuerzentrale) ──
# Gemeinsames Bearer-Token zwischen Backend und Bot-Runtime. Beide MÜSSEN denselben
# Wert haben. Generieren z.B. mit: openssl rand -hex 32
BOT_RUNTIME_TOKEN=

# Portfolio-Anbindung (Anfragen, Kunden, Umsatz auf der Startseite).
# Lesender Dienst-Schlüssel; im Portfolio als SERVICE_API_KEY hinterlegen.
# Erzeugen mit: openssl rand -hex 32
PORTFOLIO_API_KEY=
# Alter Weg: Admin-Passwort des Portfolios. Nur Fallback, kann leer bleiben.
PORTFOLIO_PASSWORD=

# Portfolio-Bot (laufen in der Bot-Runtime):
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Öffentliche URL, unter der GitHub die Webhooks erreicht (zeigt aufs Dashboard):
PORTFOLIO_WEBHOOK_URL=https://dash.mas0n1x.online/api/bots/portfolio/webhook/github
# Quelle der "Projekte"-Nachricht des Portfolio-Bots (leer = mas0n1x.online/api/projects)
PORTFOLIO_PROJECTS_URL=
# "Meine Server": Login des Bots am Dashboard (Zugangsdaten eines Dashboard-Nutzers)
BOT_HOMELAB_API_URL=http://backend:3001
BOT_HOMELAB_USER=
BOT_HOMELAB_PASSWORD=

# PersoNet-Bot (bleibt in PersoNet, wird nur mitgesteuert):
PERSONET_BOT_URL=
PERSONET_BOT_API_KEY=

# ── Minecraft-Server ──────────────────────────────────────────────
# Einzelner Server (Abwärtskompatibilität):
MC_AGENT_URL=
MC_AGENT_TOKEN=
# Mehrere Server (JSON-Array, hat Vorrang) — Switcher im Dashboard:
# MC_SERVERS=[{"id":"survival","name":"Survival","host":"188.34.130.109:25565","version":"Paper 26.2","map":"https://map.mas0n1x.online","url":"http://188.34.130.109:8100","token":"..."}]
MC_SERVERS=
